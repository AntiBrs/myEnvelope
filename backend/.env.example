# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
JWT_SECRET_KEY=replace-with-a-long-random-value
REDIS_URL=redis://127.0.0.1:6379/0
# Enable only behind one trusted reverse proxy; never expose that API directly.
TRUST_PROXY=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=myenvelope_app
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=myenvelope

# Optional: Google Cloud Document AI receipt processing
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
DOCUMENTAI_PROJECT_ID=your-google-cloud-project-id
DOCUMENTAI_LOCATION=eu
DOCUMENTAI_PROCESSOR_ID=your-processor-id
# DOCUMENTAI_ENDPOINT=eu-documentai.googleapis.com

# Optional: n8n financial assistant
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
